Package: pedigree2relate
Type: Package
Title: The package parses full wheat-pedigrees to an additive relatiosnhip matrix
Version: 0.0.0.9000
Authors@R: 
    c(person("Vishal", "Singh",
              email ="singhvis@oregonstate.edu" 
      person("Margaret", "Krause",
